<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Forkly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Forkly.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_tomato</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Forkly</item>
    </style>
</resources>
